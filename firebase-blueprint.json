{
  "entities": {
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized store owner or administrator allowed to manage synced POS configuration.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "StoreBackupMeta": {
      "title": "StoreBackupMeta",
      "description": "Encrypted POS store metadata owned by a verified administrator.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "encryptedSnapshot": {
          "type": "string",
          "maxLength": 500000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "storeName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Whitelist of verified store administrators."
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/StoreBackupMeta" },
      "description": "Owner-scoped store metadata documents."
    }
  }
}
